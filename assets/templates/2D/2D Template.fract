s":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"mouse_wheel_delta","offset":48,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"rotation","offset":20,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"dt","offset":68,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":2,"data_type":"float2","name":"extent","offset":24,"rows":1,"size":8,"sub_fields":[]},{"base_data_type":"float","cols":2,"data_type":"float2","name":"mouse_pos","offset":32,"rows":1,"size":8,"sub_fields":[]},{"base_data_type":"int","cols":1,"data_type":"int","name":"lmb_down","offset":52,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":2,"data_type":"float2","name":"mouse_delta","offset":40,"rows":1,"size":8,"sub_fields":[]},{"base_data_type":"int","cols":1,"data_type":"int","name":"rmb_down","offset":56,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"int","cols":1,"data_type":"int","name":"mmb_down","offset":60,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"t","offset":64,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"int","cols":1,"data_type":"int","name":"i","offset":72,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":4,"data_type":"float4","name":"oc","offset":80,"rows":1,"size":16,"sub_fields":[]}]}]}},{"data":[100,0,0,0,0,0,0,0,0,32,30,69,0,0,163,68],"id":3,"struct_field":{"base_data_type":"","cols":1,"data_type":"SLANG_ParameterGroup_Something","name":"Something","offset":0,"rows":1,"size":16,"sub_fields":[{"base_data_type":"int","cols":1,"data_type":"int","name":"another","offset":0,"rows":1,"size":4,"sub_fields":[]}]}}]},"source":"#include \"std/basic.slang\"\n#include \"std/2d.slang\" \n#include \"std/keys.slang\"\n \n \n \n//define parameters  \nstruct Parameters   \n{\n    //custom parameters:     \n    float a;                                                      \n                                              \n\t//space transform:\n    float2 move;    \n   \tfloat zoom;\n   \tfloat rotation;\n\n\n    //reserved parameters,autoupdated by app:\n    float2 extent;//render area extent in pixels\n\tfloat2 mouse_pos;//current mouse position in pixels\n\tfloat2 mouse_delta;//mouse delta for the last frame in pixels\n\tfloat mouse_wheel_delta;//mouse wheel delta for the last frame\n\tbool lmb_down;//if left mouse button down\n\tbool rmb_down;//if right mouse button down\n\tbool mmb_down;//if middle mouse button down\n\tfloat t;//time counter\n\tfloat dt;//time passed from last frame\n\t\n\tint i;\n\tfloat4 oc;\n};\n\n\n\n//define parameters variable p\nbuffer Parameters_{\n\n\tParameters p;\n}\n\n\tstatic struct ABC\n\t{\n\tfloat a;\n\tfloat b;\n\tfloat c;\n\t} abc;\n\n\n\n\nuniform float u2;\nuniform float u3;\n\n\n\nfloat2 uvToSpacePoint(float2 uv)\n{\n\tfloat2x2 rot=float2x2(cos(p.rotation),sin(p.rotation),-sin(p.rotation),cos(p.rotation));\n\treturn rot*(uv / p.zoom +p.move);\n}\n\nfloat2 spacePointToUv(float2 spacePoint)\n{\n\tfloat2x2 rot=float2x2(cos(p.rotation),sin(p.rotation),-sin(p.rotation),cos(p.rotation));\n\treturn  (transpose(rot)*spacePoint-p.move)*p.zoom;\n}\n\n//This function will be the result of export\n//Pass parameters through function arguments for dynamic parameters\nfloat4 MyTexture(float2 uv)\n{\n\tfloat2 pos = uvToSpacePoint(uv);\n   \treturn pos.x*pos.y*u2*p.i;\n}\n\nuniform Something\n{\n\tint another;\n}\n\nfloat4 output(float2 uv,float t)\n{\n\tfloat2 pos = uvToSpacePoint(uv);\n   \treturn p.oc+another+u2+t-showUVRect;\n}\n\nfloat2 screenToUV(float2 screenPosition)\n{\n\tscreenPosition.y=-screenPosition.y;\n\tfloat2 identitySquare;\n\tif(p.extent.x>p.extent.y)\n\t\tidentitySquare=float2(p.extent.y/p.extent.x,1);\n    else\n        identitySquare=float2(1,p.extent.x/p.extent.y);\n\treturn (screenPosition+identitySquare*previewScale*0.5)/identitySquare/previewScale;\n}\n\n//Function is called for each pixel\n//and returns color for this pixel\n//you can use it to preview output function\n//this does not affect the export result\nfloat4 main(float2 screen_pixel)\n{\n\tfloat2 uv = screenToUV(screen_pixel);\n\t\n\tfloat4 result = output(uv,p.t);\n\t\n\n\t\n   \treturn result;\n}\n\n     \n//this function called only once per frame before main\n//Allows to control parameters in one place \nvoid UpdateParameters() \n{\n\tb2d::update();\n}\n\n"}