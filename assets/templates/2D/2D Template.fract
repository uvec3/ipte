_fields":[{"base_data_type":"float","cols":1,"data_type":"float","name":"t","offset":0,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"dt","offset":4,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":2,"data_type":"float2","name":"extent","offset":8,"rows":1,"size":8,"sub_fields":[]}]}},{"data":[1,0,0,0,1,0,0,0,0,0,128,63,0,0,0,0,0,0,128,191,0,0,128,191,0,0,0,63,0,0,0,0],"id":3,"struct_field":{"base_data_type":"","cols":1,"data_type":"std.framework_2d.SLANG_ParameterGroup_Params_2d","name":"Params_2d","offset":0,"rows":1,"size":32,"sub_fields":[{"base_data_type":"int","cols":1,"data_type":"int","name":"showUVRect","offset":0,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":2,"data_type":"float2","name":"move","offset":16,"rows":1,"size":8,"sub_fields":[]},{"base_data_type":"int","cols":1,"data_type":"int","name":"showSpaceMesh","offset":4,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"previewScale","offset":8,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"zoom","offset":24,"rows":1,"size":4,"sub_fields":[]},{"base_data_type":"float","cols":1,"data_type":"float","name":"rotation","offset":28,"rows":1,"size":4,"sub_fields":[]}]}}]},"source":"#include <std/2d.slang> \n \n\nbuffer UserParameters\n{\n\tfloat t;\n\tfloat4 color;\n\tfloat4 color2;\n}\n\n\n\nfloat4 MyTexture(float2 uv)\n{\n\t//Important to do transformation of space inside texture function\n    //it will allow to preserve transformation when exporting as code\n\tvar pos=std::framework_2d::uvToSpacePoint(uv);\n\n   \treturn (float)(length(pos)<1)*color;\n}\n\n\n//texture preview\nfloat4 output(float2 uv)\n{\n   \treturn MyTexture(uv);\n}\n\n\n//once per frame update\n//use it to control parameters\nvoid update()\n{\n\tt+=std::dt;\n\tcolor.r=(sin(t)+1)/2;\n}"}